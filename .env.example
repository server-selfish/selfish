
# copy this file and change name to .env and fill the variable
# to be used by docker compose

# frontend app env
BASE_URL_BACKEND_ENDPOINT=
NODE_TLS_REJECT_UNAUTHORIZED=0
FRONTEND_PORT=

# backend app env
BACKEND_ENV=production

DB_USER=
DB_PASSWORD=
DB_NAME=

# migration
DATABASE_URL=
MIGRATIONS_GIT_REF=

# auth env
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# github_app env
AUTH_GITHUB_APP_ID=
AUTH_GITHUB_APP_SLUG=
AUTH_GITHUB_PRIVATE_KEY_PATH=

# jwt env
AUTH_JWT_SECRET=

# log env
LOG_LEVEL=info
LOG_STDOUT_ENABLED=true
LOG_STDOUT_PRETTY=true

# otel logs env (OTLP/HTTP export to VictoriaLogs)
OTEL_LOGS_ENABLED=true
OTEL_LOGS_ENDPOINT=http://selfish_logs:9428/insert/opentelemetry/v1/logs
OTEL_LOGS_INSECURE=true
OTEL_SERVICE_NAME=selfish-backend
OTEL_SERVICE_VERSION=prod